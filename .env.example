# The agent uses Claude when ANTHROPIC_API_KEY is set (get one at https://platform.claude.com/settings/keys).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional fallback: Groq is used only when ANTHROPIC_API_KEY is empty (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Set to 1 to let the agent work flagged orders in the background at startup
AUTO_AGENT=0
PORT=3000
